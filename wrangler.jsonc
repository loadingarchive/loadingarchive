{
	// Cloudflare Workers — Loading Archive
	// Docs: https://developers.cloudflare.com/workers/wrangler/configuration/
	"name": "loadingarchive",
	"main": "worker/src/index.js",
	"compatibility_date": "2024-09-23",
	// Static Assets: serves everything in loading-archive_01/ as static files.
	// The ASSETS binding lets the worker fall through to these files for any
	// route it doesn't handle itself.
	"assets": {
		"directory": "./loading-archive_01",
		"binding": "ASSETS",
		"run_worker_first": true
	},
	// KV namespace for pre-built game data.
	// Keys: "games:2026-01" … "games:2026-12", "games:tba", "config:extra-games"
	// remote: true → wrangler dev also uses the real KV (no local simulation needed)
	"kv_namespaces": [
		{
			"binding": "GAMES_KV",
			"id": "cccc2aea7c3c44379b6fe07a28e06bff",
			"remote": true
		}
	],
	// Five cron triggers, all dispatched by scheduled() in index.js.
	// De dagelijkse keten is gesplitst over drie invocaties vanwege het
	// subrequest-budget (~1000 per invocation):
	//   0 3 * * *   → maanden jan–jun (runMonthsCron 1–6)
	//   45 3 * * *  → maanden jul–dec + TBA (runMonthsCron 7–12)
	//   30 4 * * *  → maintenance: soft-delete, KV-rebuild, sitemap,
	//                 appid-backfill, prijsupdate (runMaintenanceCron)
	//   0 4 * * 7   → weekly Sunday: Wikipedia scrape (runWeeklyWikipediaCron)
	//   0 * * * *   → hourly: trending refresh (runHourlyCron)
	"triggers": {
		"crons": [
			"0 3 * * *",
			"45 3 * * *",
			"30 4 * * *",
			"0 4 * * 7",
			"0 * * * *"
		]
	},
	// D1 database: duurzame bron van waarheid voor alle games.
	// KV blijft de snelle leescache voor publiek verkeer.
	"d1_databases": [
		{
			"binding": "GAMES_D1",
			"database_name": "loadingarchive_games",
			"database_id": "70fde97b-0c21-40e5-87e6-abf655aa2772"
		}
	],
	"workers_dev": true,
	"routes": [
		{ "pattern": "www.loadingarchive.com", "custom_domain": true },
		{ "pattern": "loadingarchive.com",     "custom_domain": true }
	]
}